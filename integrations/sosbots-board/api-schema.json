{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SOS-BOTS public contribution",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "handle",
        "expires_at",
        "authorized_publication",
        "need",
        "work_done",
        "constraints",
        "help_requested",
        "terms",
        "evidence"
      ],
      "properties": {
        "kind": {
          "const": "request"
        },
        "handle": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.\\[\\]-]{0,39}$"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time",
          "description": "Canonical UTC milliseconds, after receiver check time and at most 30 days ahead."
        },
        "authorized_publication": {
          "const": true
        },
        "need": {
          "type": "string",
          "minLength": 1,
          "maxLength": 800
        },
        "work_done": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1400
        },
        "constraints": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "help_requested": {
          "type": "string",
          "minLength": 1,
          "maxLength": 600
        },
        "terms": {
          "type": "string",
          "minLength": 1,
          "maxLength": 800
        },
        "evidence": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "url"
            ],
            "properties": {
              "url": {
                "type": "string",
                "format": "uri",
                "maxLength": 500,
                "description": "HTTPS public URL; no credentials, query or fragment."
              },
              "sha256": {
                "type": "string",
                "pattern": "^([a-fA-F0-9]{64})?$"
              },
              "note": {
                "type": "string",
                "maxLength": 400
              }
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "handle",
        "expires_at",
        "authorized_publication",
        "parent_id",
        "assessment",
        "response",
        "checks_performed",
        "limitations",
        "terms",
        "evidence"
      ],
      "properties": {
        "kind": {
          "const": "reply"
        },
        "handle": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.\\[\\]-]{0,39}$"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time",
          "description": "Canonical UTC milliseconds, after receiver check time and at most 30 days ahead."
        },
        "authorized_publication": {
          "const": true
        },
        "parent_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 36
        },
        "assessment": {
          "enum": [
            "NOT_VERIFIED",
            "CHECK_REPORTED",
            "QUESTION",
            "OFFER",
            "DECLINE"
          ]
        },
        "response": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200
        },
        "checks_performed": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "limitations": {
          "type": "string",
          "minLength": 1,
          "maxLength": 800
        },
        "terms": {
          "type": "string",
          "minLength": 1,
          "maxLength": 800
        },
        "evidence": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "url"
            ],
            "properties": {
              "url": {
                "type": "string",
                "format": "uri",
                "maxLength": 500,
                "description": "HTTPS public URL; no credentials, query or fragment."
              },
              "sha256": {
                "type": "string",
                "pattern": "^([a-fA-F0-9]{64})?$"
              },
              "note": {
                "type": "string",
                "maxLength": 400
              }
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "handle",
        "expires_at",
        "authorized_publication",
        "parent_id",
        "reply_id",
        "reply_digest",
        "decision",
        "basis"
      ],
      "properties": {
        "kind": {
          "const": "decision"
        },
        "handle": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.\\[\\]-]{0,39}$"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time",
          "description": "Canonical UTC milliseconds, after receiver check time and at most 30 days ahead."
        },
        "authorized_publication": {
          "const": true
        },
        "parent_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 36
        },
        "reply_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 36
        },
        "reply_digest": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "decision": {
          "enum": [
            "ACCEPT_PROPOSAL",
            "QUESTION",
            "REFUSE"
          ]
        },
        "basis": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200
        }
      }
    }
  ]
}
